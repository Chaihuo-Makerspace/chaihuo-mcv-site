---
import Navigation from '@/app/components/Navigation';
import Footer from '@/layouts/Footer.astro';
import '@/styles/index.css';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '@/i18n/index';
import { getAlternateUrl } from '@/i18n/index';
import ui from '@/i18n/ui';
import { BUILD_ID } from '@/lib/build-info';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** 追加的 JSON-LD 结构化数据（GEO），按页面注入（如首页 Project schema） */
  jsonLd?: Record<string, unknown>[];
  /** og:type：内容页（日记）传 'article' */
  ogType?: 'website' | 'article';
  /** 不希望被索引的页面（设计对照页等） */
  noindex?: boolean;
}

const locale = (Astro.currentLocale ?? 'zh') as Locale;
const dict = ui[locale];

const {
  title,
  description = dict['site.description'],
  ogImage = '/og-default.png',
  jsonLd = [],
  ogType = 'website',
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const siteUrl = (Astro.site ?? new URL('https://mcv.chaihuo.org')).origin;
const canonicalURL = new URL(pathname, siteUrl);

const htmlLang = locale === 'zh' ? 'zh-CN' : 'en';
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
const siteTitle = `${title} | ${dict['site.name']}`;

// JSON-LD 结构化数据（GEO：Organization + WebSite 全站注入，页面级 schema 经 jsonLd prop 追加）
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.chaihuo.org',
  name: '柴火创客空间',
  alternateName: 'Chaihuo Makerspace',
  url: 'https://www.chaihuo.org',
  logo: 'https://www.chaihuo.org/Images/logo.png',
  description: '开源创客空间，柴火AI基地车发起方与运营方',
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: dict['site.name'],
  alternateName: locale === 'zh' ? 'Chaihuo MCV' : '柴火基地车',
  url: siteUrl + (locale === 'zh' ? '/' : '/en/'),
  publisher: { '@id': 'https://www.chaihuo.org' },
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
};
const jsonLdBlock = [organizationJsonLd, websiteJsonLd, ...jsonLd];

const alternate = getAlternateUrl(pathname);
const alternateURL = new URL(alternate.path, Astro.site ?? 'https://mcv.chaihuo.org');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="build-id" content={BUILD_ID} />
    <meta name="theme-color" content="#f3d230" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {/* 首屏标题字体预加载，缩短 FOUT/CLS 窗口（与 fonts.css 同源同 URL 才会命中） */}
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SmileySans-hero-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <title>{siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.href} />

    {/* hreflang tags */}
    <link rel="alternate" hreflang="zh" href={locale === 'zh' ? canonicalURL.href : alternateURL.href} />
    <link rel="alternate" hreflang="en" href={locale === 'en' ? canonicalURL.href : alternateURL.href} />
    <link rel="alternate" hreflang="x-default" href={locale === 'zh' ? canonicalURL.href : alternateURL.href} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={dict['site.name']} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    {/* JSON-LD 结构化数据（GEO） */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdBlock)} />

    {/* 统计脚本（Clarity + GA4）：等 load 后空闲时再注入，不与首屏资源争带宽/主线程。
        gtag/clarity 队列桩先就位，早期调用不会丢失。 */}
    <script is:inline>
      (function (w, d) {
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () { w.dataLayer.push(arguments); };
        w.gtag('js', new Date());
        w.gtag('config', 'G-27XRD69LSR');
        w.clarity = w.clarity || function () { (w.clarity.q = w.clarity.q || []).push(arguments); };
        function inject(src) {
          var t = d.createElement('script');
          t.async = true;
          t.src = src;
          d.head.appendChild(t);
        }
        function boot() {
          inject('https://www.googletagmanager.com/gtag/js?id=G-27XRD69LSR');
          inject('https://www.clarity.ms/tag/wc0b9nadad');
        }
        function idle() {
          if (w.requestIdleCallback) w.requestIdleCallback(boot, { timeout: 3000 });
          else setTimeout(boot, 1500);
        }
        if (d.readyState === 'complete') idle();
        else w.addEventListener('load', idle, { once: true });
      })(window, document);
    </script>
    {/* 新部署自动刷新（思路同 Nuxt app manifest：导航触发优先，低频轮询兜底）：
        ① ClientRouter 切换页面时本就要抓取新页面 HTML，直接比对其中的 build-id，零额外请求；
        ② 停留在单页时低频轮询 /api/version（60s，后台标签页暂停，Save-Data 关闭轮询）；
        版本号变化即强制刷新，访客无需手动 F5 */}
    <script is:inline>
      (function () {
        var meta = document.querySelector('meta[name="build-id"]');
        var current = meta && meta.content;
        if (!current) return;
        var POLL_MS = 60000;
        var timer = null;

        function reload() {
          // 60 秒内已刷新过却仍是旧版本 → 停止，避免 CDN 缓存旧 HTML 导致无限刷新
          try {
            var now = Date.now();
            if (now - Number(sessionStorage.getItem('mcv-reload-at') || 0) < 60000) return;
            sessionStorage.setItem('mcv-reload-at', String(now));
          } catch (e) {}
          location.reload();
        }

        function outdated(version) {
          return version && version !== current;
        }

        // ① 客户端路由切换后：DOM 已是 ClientRouter 抓取的新文档，直接读它的 build-id。
        // 若来自新部署则强制整页刷新，避免旧 JS islands 与新 HTML 混用
        document.addEventListener('astro:page-load', function () {
          var m = document.querySelector('meta[name="build-id"]');
          if (m && outdated(m.content)) reload();
        });

        // ② 兜底轮询：覆盖长时间停留在单页、不发生导航的访问
        function check() {
          fetch('/api/version?t=' + Date.now(), { cache: 'no-store' })
            .then(function (res) { return res.ok ? res.json() : null; })
            .then(function (data) {
              if (data && outdated(data.version)) reload();
            })
            .catch(function () {});
        }

        function start() { if (!timer) timer = setInterval(check, POLL_MS); }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }

        // 后台标签页暂停轮询；切回前台立即检查一次，第一时间发现新部署
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'visible') { check(); start(); } else { stop(); }
        });
        // 从 bfcache 恢复时也检查一次
        window.addEventListener('pageshow', function () { check(); start(); });
        // 省流模式下不轮询，仅靠导航检测（零额外请求）
        if (!(navigator.connection && navigator.connection.saveData)) start();
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-surface text-neutral-900">
    <Navigation client:load pathname={pathname} locale={locale} transition:persist />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
