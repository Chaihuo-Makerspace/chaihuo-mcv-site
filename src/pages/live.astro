---
// 游离页面：不进导航、noindex，只能通过直接链接访问。必须 SSR（不 prerender），
// 因为 latest.json 每次请求都要重新读。
import LiveContent from '@/app/components/LiveContent';
import type { Locale } from '@/i18n/index';
import liveDict from '@/i18n/live';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { readLiveMeta } from '@/lib/live';

const locale = (Astro.currentLocale ?? 'zh') as Locale;
const t = liveDict[locale];
const meta = readLiveMeta();
---

<BaseLayout title={t['title']} description={t['description']}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <LiveContent client:load locale={locale} t={t} initialMeta={meta} />
</BaseLayout>
