---
export const prerender = true;

import HomeContent from '@/app/components/HomeContent';
import type { LiveVideo } from '@/app/components/LiveVideos';
import { PROJECT_END, PROJECT_START } from '@/config/project';
import boardingsData from '@/data/boardings.json';
import heroesData from '@/data/heroes.json';
import videosData from '@/data/live-videos.json';
import partnersData from '@/data/partners.json';
import pressData from '@/data/press.json';
import projectIntroData from '@/data/project-intro.json';
import teamData from '@/data/team.json';
import { buildRouteLegs } from '@/features/route-map/route-legs';
import { loadLocalizedStops } from '@/features/route-map/stops-loader';
import home from '@/i18n/home';
import type { Locale } from '@/i18n/index';
import { localize } from '@/i18n/index';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { createDerivativeResolver } from '@/lib/derivatives';
import { withAvatarDerivatives } from '@/lib/people';

const locale = (Astro.currentLocale ?? 'zh') as Locale;
const t = home[locale];

// 首页媒体报道（C：featured 置顶 + 完整时间线，一源两处渲染）
const press = pressData.map((p) => ({
  source: locale === 'en' && p.source_en ? p.source_en : p.source,
  sourceUrl: p.sourceUrl,
  title: locale === 'en' && p.title_en ? p.title_en : p.title,
  date: p.date ?? '',
  tier: p.tier ?? 'full',
  category: p.category ?? 'media',
}));

// 首页共建伙伴条（轻量 logo 条，一源两处：About 完整三档 + 首页紧凑条）
const partnerLogoFiles = import.meta.glob('@/assets/partners/*.{png,svg}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
const logoByFileName = new Map(
  Object.entries(partnerLogoFiles).map(([key, url]) => [key.split('/').pop(), url]),
);
const PARTNER_LOGO_MAP: Record<string, string> = {
  chaihuo: logoByFileName.get('chaihuo-logo.png') ?? '',
  seeed: logoByFileName.get('seeed-logo.png') ?? '',
  nvidia: logoByFileName.get('nvidia-logo.png') ?? '',
  'maker-media': logoByFileName.get('maker-media.svg') ?? '',
  fablab: logoByFileName.get('fablab.svg') ?? '',
  makera: logoByFileName.get('makera.png') ?? '',
  'shenzhen-stm': logoByFileName.get('szstm-logo.png') ?? '',
};
const partners = partnersData.map((p) => ({
  id: p.id,
  name: p.name,
  description: locale === 'en' ? p.description_en : p.description,
  tier: p.tier ?? 'partner',
  link: p.link ?? '',
  logo: PARTNER_LOGO_MAP[p.id] ?? '',
}));

// 移动端 hero 轮播用 768px 派生图(public/heroes/mobile/,构建时生成,缺失回退原图)
const heroMobile = createDerivativeResolver('/heroes/mobile');
const heroImages = heroesData.map((h) => ({ ...h, imageMobile: heroMobile(h.image) }));
const firstHero = heroImages[0];

const cities = await loadLocalizedStops(locale);

// 首页「路上的故事」视频条（飞书 Base 同步产物，scripts/sync-live-videos.mjs）
const videos = videosData.videos.map((video) =>
  localize(video, ['eyebrow', 'title', 'description'], locale),
) as LiveVideo[];

// Island payload:HomeContent/RoutePreview 只读地图几何与当前站点事实卡字段,
// 事件/人物/散文等完整 Stop 数据不出服务端(timeline legs 仍用完整 cities)
const islandCities = cities.map((c) => ({
  id: c.id,
  order: c.order,
  visited: c.visited,
  isOrigin: c.isOrigin,
  anchor: c.anchor,
  routeOnly: c.routeOnly,
  label: c.label,
  lng: c.lng,
  lat: c.lat,
  altitude: c.altitude,
  terrain: c.terrain,
  climate: c.climate,
  challenge: c.challenge,
}));

const memberById = new Map(teamData.map((m) => [m.id, m] as const));
const memberDisplayName = (id: string | undefined) => {
  if (!id) return null;
  const m = memberById.get(id);
  if (!m) return null;
  return locale === 'en' ? m.name_en || m.name : m.name;
};

const segments = withAvatarDerivatives(
  boardingsData
    .map((b) => {
      const member = memberById.get(b.crewId);
      if (!member) return null;
      const handoffToId = (b.disembarkedAt as { handoffTo?: string } | null)?.handoffTo;
      return {
        id: b.id,
        role: b.role,
        crewId: member.id,
        name: locale === 'en' ? member.name_en || member.name : member.name,
        image: member.image,
        bio: locale === 'en' ? member.bio_en || member.bio || '' : member.bio || '',
        startDate: b.boardedAt.date,
        endDate: b.disembarkedAt?.date ?? null,
        handoffName: memberDisplayName(handoffToId),
        startLocation: locale === 'en' ? b.boardedAt.location_en : b.boardedAt.location,
        endLocation: b.disembarkedAt
          ? locale === 'en'
            ? b.disembarkedAt.location_en
            : b.disembarkedAt.location
          : null,
      };
    })
    .filter((x): x is NonNullable<typeof x> => x !== null),
);

const ROLE_ORDER = ['领队', '技术担当', '媒体担当', '场景担当'];
const roles = ROLE_ORDER.map((r) => {
  const roleEn = teamData.find((tm) => tm.role === r)?.role_en;
  // zh 页: 中文主标签 + 英文副标签; en 页反之
  return locale === 'zh'
    ? { key: r, label: r, sub: roleEn ?? '' }
    : { key: r, label: roleEn ?? r, sub: r };
});

// Month markers — first day of each month within the project window
const monthMarkers: Array<{ label: string; pct: number }> = [];
const startDate = new Date(`${PROJECT_START}T00:00:00Z`);
const endDate = new Date(`${PROJECT_END}T00:00:00Z`);
const totalMs = endDate.getTime() - startDate.getTime();
const cursor = new Date(startDate);
cursor.setUTCDate(1);
if (cursor < startDate) cursor.setUTCMonth(cursor.getUTCMonth() + 1);
while (cursor < endDate) {
  const pct = ((cursor.getTime() - startDate.getTime()) / totalMs) * 100;
  if (pct >= 0 && pct <= 100) {
    const label =
      locale === 'en'
        ? cursor.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase()
        : `${cursor.getUTCMonth() + 1}月`;
    monthMarkers.push({ label, pct });
  }
  cursor.setUTCMonth(cursor.getUTCMonth() + 1);
}

const timeline = {
  roles,
  segments,
  monthMarkers,
  legs: buildRouteLegs(cities, locale),
  projectStart: PROJECT_START,
  projectEnd: PROJECT_END,
};

// 首页 Project 结构化数据（GEO）：定性句原文直接进 schema，供 AI 引擎引用
const projectIntro = projectIntroData[locale];
const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Project',
  name: locale === 'zh' ? '柴火AI基地车' : 'Chaihuo AI Base Vehicle',
  alternateName: locale === 'zh' ? 'Chaihuo AI Base Vehicle' : '柴火AI基地车',
  description: projectIntro.intro,
  url: 'https://mcv.chaihuo.org/',
  founder: { '@id': 'https://www.chaihuo.org' },
};
---

<BaseLayout title={t['title']} description={t['description']} jsonLd={[projectJsonLd]}>
  {/* 首屏 LCP:只预加载第一张轮播图,按视口宽度各取桌面/移动派生 */}
  <link slot="head" rel="preload" as="image" href={firstHero.image} media="(min-width: 768px)" />
  <link slot="head" rel="preload" as="image" href={firstHero.imageMobile} media="(max-width: 767.98px)" />
  {/* B 站弹层播放器：提前握手，点开少等一个连接建立 */}
  <link slot="head" rel="preconnect" href="https://player.bilibili.com" crossorigin />
  <link slot="head" rel="dns-prefetch" href="https://player.bilibili.com" />
  <HomeContent
    client:load
    cities={islandCities}
    heroImages={heroImages}
    timeline={timeline}
    press={press}
    partners={partners}
    videos={videos}
    locale={locale}
    t={t}
  />
</BaseLayout>
