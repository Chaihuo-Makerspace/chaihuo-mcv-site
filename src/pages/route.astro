---
export const prerender = true;

import RouteContent from '@/app/components/RouteContent';
import { loadLocalizedStops } from '@/features/route-map/stops-loader';
import type { Locale } from '@/i18n/index';
import routeDict from '@/i18n/route';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getRouteJournals } from '@/lib/journals';

const locale = (Astro.currentLocale ?? 'zh') as Locale;
const t = routeDict[locale];

// Stops collection — localized once at page level
const cities = await loadLocalizedStops(locale);

const journals = await getRouteJournals(cities, locale);
---

<BaseLayout title={t['route.pageTitle']} description={t['route.pageDesc']}>
  {/* client:idle — the page is fully SSR'd; deferring hydration keeps first visit
      responsive while the heavy map bundle (maplibre + embedded geo data) loads. */}
  <RouteContent client:idle cities={cities} journals={journals} locale={locale} t={t} />
</BaseLayout>
