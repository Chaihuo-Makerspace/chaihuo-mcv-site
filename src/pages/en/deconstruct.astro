---
export const prerender = true;

import { getCollection } from 'astro:content';
import DeconstructContent from '@/app/components/DeconstructContent';
import cocreationData from '@/data/cocreation.json';
import coursesData from '@/data/courses.json';
import solutionsData from '@/data/solutions.json';
import techModulesData from '@/data/tech-modules.json';
import deconstructDict from '@/i18n/deconstruct';
import type { Locale } from '@/i18n/index';
import { localize } from '@/i18n/index';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { createDerivativeResolver, getPublicImageSize } from '@/lib/derivatives';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = deconstructDict[locale];

const notesCollection = await getCollection('notes');
const notes = await Promise.all(
  notesCollection.map(async (note) => ({
    date: note.data.date,
    title: locale === 'en' && note.data.title_en ? note.data.title_en : note.data.title,
    description:
      locale === 'en' && note.data.description_en ? note.data.description_en : note.data.description,
    image: note.data.image,
    tags: locale === 'en' && note.data.tags_en ? note.data.tags_en : note.data.tags,
    yuqueUrl: note.data.yuqueUrl,
    // 原始宽高供 <img> width/height 防 CLS;读不到时省略
    ...(await getPublicImageSize(note.data.image)),
  })),
);

// 解决方案卡片只渲染 112px 高,用 224px 派生图(构建时生成,缺失回退原图)
const solutionThumb = createDerivativeResolver('/deconstruct/solutions/thumb');
const allSolutions = [...solutionsData.tech, ...solutionsData.scenarios];
const solutionById = new Map(
  allSolutions.map((sol) => {
    const loc = localize(sol, ['title'], locale);
    return [sol.id, { id: sol.id, url: sol.url, image: solutionThumb(sol.image), title: loc.title }];
  })
);

const techModules = techModulesData.map((mod) => {
  const loc = localize(mod, ['category', 'title', 'subtitle', 'description'], locale);
  return {
    id: mod.id,
    icon: mod.icon,
    category: loc.category,
    title: loc.title,
    subtitle: loc.subtitle,
    description: loc.description,
    devices: mod.devices,
    solution: ('solutionId' in mod && solutionById.get(mod.solutionId as string)) || null,
  };
});

const localizeCocreation = (items: typeof cocreationData.directions) =>
  items.map((item) => {
    const loc = localize(item, ['title', 'description'], locale);
    return { id: item.id, icon: item.icon, title: loc.title, description: loc.description };
  });

const directions = localizeCocreation(cocreationData.directions);
const programs = localizeCocreation(cocreationData.programs);

const courses = coursesData.map((course) => {
  const loc = localize(course, ['title', 'tagline'], locale);
  return {
    id: course.id,
    code: course.code,
    title: loc.title,
    tagline: loc.tagline,
    url: course.url,
    scenarios: locale === 'en' && course.scenarios_en ? course.scenarios_en : course.scenarios,
    solutions: course.solutionIds
      .map((id) => solutionById.get(id))
      .filter((sol): sol is NonNullable<typeof sol> => Boolean(sol)),
  };
});

---

<BaseLayout title={t['title']} description={t['description']}>
  <DeconstructContent
    client:idle
    techModules={techModules}
    courses={courses}
    directions={directions}
    programs={programs}
    notes={notes}
    locale={locale}
    t={t}
  />
</BaseLayout>
